# Modèle des variables du site. Copier en .env.local (ignoré par Git) et
# compléter ; sur Vercel, les saisir dans Settings > Environment Variables.

# Envoi des e-mails du formulaire de contact, par le serveur SMTP de Hostinger.
# Le site se connecte avec la boîte de Johana et envoie sous l’alias
# contact@laborientation.com (voir content/site.ts).
# Tant que SMTP_PASSWORD est vide, les e-mails sont seulement notés dans le
# journal du serveur.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
